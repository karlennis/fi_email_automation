{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPlanningBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::planning-documents-2"
    },
    {
      "Sid": "ReadWritePlanningObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::planning-documents-2/planning-docs/*",
        "arn:aws:s3:::planning-documents-2/filter-docs/*"
      ]
    }
  ]
}
