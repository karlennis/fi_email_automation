NODE_ENV=production
PORT=3001

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fi-email-automation?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-64-character-jwt-secret-here
JWT_EXPIRES_IN=7d

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Email Configuration (SMTP)
# For Google Workspace: Use your company mailbox email and an app-specific password
# Steps to get app password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification (if not already done)
# 3. Generate App Password (select Mail + your device)
# 4. Use the 16-character password below (with or without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-company-email@buildinginfo.com
SMTP_PASS=your-16-character-app-password

# Email sender configuration
# FROM_EMAIL: The email address that will appear as the sender
# FROM_NAME: The display name for the sender
# REPLY_TO_EMAIL: Where replies should be directed
FROM_EMAIL=your-company-email@buildinginfo.com
FROM_NAME=Your Company Name
REPLY_TO_EMAIL=support@buildinginfo.com

# Building Info API Configuration
BUILDING_INFO_API_BASE_URL=https://api12.buildinginfo.com/api/v2/bi/projects/t-projects
BUILDING_INFO_API_KEY=your-building-info-api-key
BUILDING_INFO_API_UKEY=your-building-info-ukey

# AWS Configuration
# S3_BUCKET and AWS_REGION are canonical. S3_BUCKET_NAME and AWS_S3_BUCKET_NAME are
# legacy aliases that still resolve, but setting one of them to a DIFFERENT value than
# S3_BUCKET makes the process refuse to boot - half the pipeline would point at one
# bucket and half at another, which reports success with zero matches. Same for
# S3_REGION vs AWS_REGION. See backend/utils/awsConfig.js.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=eu-north-1
S3_BUCKET=planning-documents-2
S3_REGION=eu-north-1

# Frontend URL (for CORS and email links)
FRONTEND_URL=https://fi-email-automation-frontend.onrender.com

# Job Queue Configuration
QUEUE_CONCURRENCY=3

# Logging Configuration
#
# LOG_LEVEL controls the CONSOLE only (what PM2 captures as you watch it live). The log
# files are fixed, so raising this to debug for an hour cannot cost you the app- record,
# and leaving it at info cannot cost you the debug trail.
LOG_LEVEL=info

# Where the dated log files are written. Defaults to /var/log/fi_email in production
# (created by deploy-ec2.sh) and backend/logs everywhere else. Read them back with
# `npm run logs -- --runs`.
#   app-YYYY-MM-DD.log     INFO and above    14 days
#   debug-YYYY-MM-DD.log   everything         3 days
#   error-YYYY-MM-DD.log   ERROR only        30 days
# LOG_DIR=/var/log/fi_email

# Documents between progress lines during a scan (default 500). Lower it to watch a run
# more closely; the per-document detail is in debug-DATE.log either way.
# SCAN_PROGRESS_INTERVAL=500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
